OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: a URL or email that identifies you to Wikipedia's API (its robot policy asks for one).
# RESEARCH_BRIEF_CONTACT=https://github.com/your-name/your-repo

# Optional (Week 10): LangSmith tracing. Free tier at https://smith.langchain.com - sign up, then
# copy your API key. If these three are unset, the app still works exactly the same; you just get
# brief/tracing.py's local JSON trace files instead of a LangSmith dashboard. Nothing in this repo
# requires LangSmith - it's purely optional observability layered on top.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=ai-engineering-week10
